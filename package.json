{
  "name": "hotel-offer-orchestrator",
  "version": "1.0.0",
  "type": "module",
  "description": "Hotel Offer Orchestrator using Node.js, Express, Temporal, Redis, and TypeScript",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc && cp -r src/docs dist/docs 2>/dev/null || true && cp -r src/public dist/public 2>/dev/null || true",
    "start": "node dist/server.js",
    "worker": "node dist/temporal/worker.js",
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/temporal/worker.ts",
    "typecheck": "tsc --noEmit",
    "deploy": "vercel --prod"
  },
  "dependencies": {
    "@temporalio/activity": "^1.11.0",
    "@temporalio/client": "^1.11.0",
    "@temporalio/worker": "^1.11.0",
    "@temporalio/workflow": "^1.11.0",
    "axios": "^1.7.9",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "ioredis": "^5.4.2",
    "pino": "^9.6.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/ioredis-mock": "^8.2.8",
    "@types/node": "^22.10.2",
    "@types/swagger-ui-express": "^4.1.7",
    "ioredis-mock": "^8.13.1",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
